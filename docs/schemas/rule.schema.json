{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ha-smart-analyst.local/schemas/rule.schema.json",
  "title": "HA Smart Analyst rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "expression"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "scope_id": { "type": ["string", "null"] },
    "enabled": { "type": "boolean" },
    "severity": { "enum": ["info", "warning", "critical"] },
    "timezone": { "type": ["string", "null"] },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/rootAllWithDuration" },
        { "$ref": "#/$defs/condition" }
      ]
    },
    "for_seconds": { "type": "integer", "minimum": 0 },
    "recovery": { "$ref": "#/$defs/recovery" },
    "missing_data_policy": {
      "enum": ["unknown", "ignore", "treat_as_failure", "separate_data_quality_incident"]
    },
    "repeat_seconds": { "type": ["integer", "null"], "minimum": 1 },
    "on_recovery": { "type": "boolean" },
    "debounce_seconds": { "type": "integer", "minimum": 0 },
    "cooldown_seconds": { "type": "integer", "minimum": 0 },
    "recipients": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "notify": { "$ref": "#/$defs/notify" }
  },
  "$defs": {
    "compareOp": { "enum": ["gt", "ge", "lt", "le", "eq", "ne"] },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": ["string", "null"] }
      }
    },
    "measurementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id"],
      "properties": { "measurement_id": { "type": "string", "minLength": 1 } }
    },
    "derived": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["difference"],
          "properties": {
            "difference": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/operand" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["abs_deviation"],
          "properties": {
            "abs_deviation": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/operand" }
            }
          }
        }
      ]
    },
    "operand": {
      "oneOf": [
        { "$ref": "#/$defs/measurementRef" },
        { "$ref": "#/$defs/literal" },
        { "$ref": "#/$defs/derived" }
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "seconds"],
      "properties": {
        "op": { "const": "duration_true" },
        "seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": { "$ref": "#/$defs/compareOp" },
        "left": { "$ref": "#/$defs/operand" },
        "right": { "$ref": "#/$defs/operand" }
      }
    },
    "between": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "low", "high"],
      "properties": {
        "op": { "const": "between" },
        "measurement_id": { "type": "string" },
        "low": { "$ref": "#/$defs/literal" },
        "high": { "$ref": "#/$defs/literal" },
        "invert": { "type": "boolean" }
      }
    },
    "stateIs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "state"],
      "properties": {
        "op": { "const": "state_is" },
        "measurement_id": { "type": "string" },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "stateChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "state"],
      "properties": {
        "op": { "enum": ["state_changed_to", "state_changed_from"] },
        "measurement_id": { "type": "string" },
        "state": { "type": "string", "minLength": 1 },
        "within_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "isUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id"],
      "properties": {
        "op": { "const": "is_unavailable" },
        "measurement_id": { "type": "string" }
      }
    },
    "isStale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "max_age_seconds"],
      "properties": {
        "op": { "const": "is_stale" },
        "measurement_id": { "type": "string" },
        "max_age_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "deltaAbove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "window_seconds", "threshold"],
      "properties": {
        "op": { "const": "delta_above" },
        "measurement_id": { "type": "string" },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "threshold": { "$ref": "#/$defs/literal" },
        "absolute": { "type": "boolean" }
      }
    },
    "rateAbove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "measurement_id", "window_seconds", "threshold"],
      "properties": {
        "op": { "const": "rate_above" },
        "measurement_id": { "type": "string" },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "threshold": { "$ref": "#/$defs/literal" }
      }
    },
    "conditionLeaf": {
      "oneOf": [
        { "$ref": "#/$defs/compare" },
        { "$ref": "#/$defs/between" },
        { "$ref": "#/$defs/stateIs" },
        { "$ref": "#/$defs/stateChanged" },
        { "$ref": "#/$defs/isUnavailable" },
        { "$ref": "#/$defs/isStale" },
        { "$ref": "#/$defs/deltaAbove" },
        { "$ref": "#/$defs/rateAbove" }
      ]
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/conditionLeaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "rootAllWithDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 2,
          "contains": { "$ref": "#/$defs/duration" },
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/condition" },
              { "$ref": "#/$defs/duration" }
            ]
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clear_below": { "$ref": "#/$defs/literal" },
        "clear_above": { "$ref": "#/$defs/literal" },
        "stable_seconds": { "type": "integer", "minimum": 0 },
        "measurement_id": { "type": "string" }
      },
      "anyOf": [
        { "required": ["clear_below"] },
        { "required": ["clear_above"] }
      ]
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeat_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "on_recovery": { "type": "boolean" }
      }
    }
  }
}
